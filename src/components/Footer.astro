---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="brand">
      <span class="logo"><span class="logo-mark">Tu</span>WebEmpresarial</span>
      <p>Diseño y desarrollo web para pequeñas empresas.</p>
    </div>
    <nav class="footer-nav" aria-label="Pie de página">
      <a href="#servicios">Servicios</a>
      <a href="#precios">Precios</a>
      <a href="#proceso">Proceso</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </div>
  <div class="container copyright">
    <p>© {year} TuWebEmpresarial. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    padding: 4rem 0 1.5rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
    padding-bottom: 2rem;
  }

  .logo {
    font-weight: 800;
    font-size: 1.15rem;
  }

  .logo-mark {
    color: var(--brand);
  }

  .brand p {
    color: var(--muted);
    margin-top: 0.4rem;
    max-width: 280px;
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
  }

  .footer-nav a {
    color: var(--muted);
    font-weight: 500;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .copyright {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
